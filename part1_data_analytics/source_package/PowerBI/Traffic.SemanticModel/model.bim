{
  "name": "Traffic",
  "compatibilityLevel": 1567,
  "model": {
    "culture": "en-US",
    "defaultPowerBIDataSourceVersion": "powerBI_V3",
    "tables": [
      {
        "name": "TrafficRaw",
        "columns": [
          {
            "name": "holiday",
            "dataType": "string",
            "sourceColumn": "holiday",
            "summarizeBy": "none"
          },
          {
            "name": "temp",
            "dataType": "double",
            "sourceColumn": "temp",
            "summarizeBy": "none"
          },
          {
            "name": "rain_1h",
            "dataType": "double",
            "sourceColumn": "rain_1h",
            "summarizeBy": "none"
          },
          {
            "name": "snow_1h",
            "dataType": "double",
            "sourceColumn": "snow_1h",
            "summarizeBy": "none"
          },
          {
            "name": "clouds_all",
            "dataType": "int64",
            "sourceColumn": "clouds_all",
            "summarizeBy": "none"
          },
          {
            "name": "weather_main",
            "dataType": "string",
            "sourceColumn": "weather_main",
            "summarizeBy": "none"
          },
          {
            "name": "weather_description",
            "dataType": "string",
            "sourceColumn": "weather_description",
            "summarizeBy": "none"
          },
          {
            "name": "date_time",
            "dataType": "dateTime",
            "sourceColumn": "date_time",
            "summarizeBy": "none"
          },
          {
            "name": "traffic_volume",
            "dataType": "int64",
            "sourceColumn": "traffic_volume",
            "summarizeBy": "none"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "TrafficRawImport",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let",
                " Source=Csv.Document(Binary.Decompress(Binary.FromText(\"\",BinaryEncoding.Base64),Compression.Deflate),[Delimiter=\",\",Columns=9,Encoding=65001,QuoteStyle=QuoteStyle.Csv]),",
                " Headers=Table.PromoteHeaders(Source,[PromoteAllScalars=true]),",
                " Typed=Table.TransformColumnTypes(Headers,{{\"holiday\",type text},{\"temp\",type number},{\"rain_1h\",type number},{\"snow_1h\",type number},{\"clouds_all\",Int64.Type},{\"weather_main\",type text},{\"weather_description\",type text},{\"date_time\",type datetime},{\"traffic_volume\",Int64.Type}},\"en-US\")",
                "in Typed"
              ]
            }
          }
        ]
      },
      {
        "name": "TrafficHourly",
        "columns": [
          {
            "name": "holiday",
            "dataType": "string",
            "sourceColumn": "holiday",
            "summarizeBy": "none"
          },
          {
            "name": "temp",
            "dataType": "double",
            "sourceColumn": "temp",
            "summarizeBy": "none"
          },
          {
            "name": "rain_1h",
            "dataType": "double",
            "sourceColumn": "rain_1h",
            "summarizeBy": "none"
          },
          {
            "name": "snow_1h",
            "dataType": "double",
            "sourceColumn": "snow_1h",
            "summarizeBy": "none"
          },
          {
            "name": "clouds_all",
            "dataType": "int64",
            "sourceColumn": "clouds_all",
            "summarizeBy": "none"
          },
          {
            "name": "weather_main",
            "dataType": "string",
            "sourceColumn": "weather_main",
            "summarizeBy": "none"
          },
          {
            "name": "weather_description",
            "dataType": "string",
            "sourceColumn": "weather_description",
            "summarizeBy": "none"
          },
          {
            "name": "date_time",
            "dataType": "dateTime",
            "sourceColumn": "date_time",
            "summarizeBy": "none"
          },
          {
            "name": "traffic_volume",
            "dataType": "int64",
            "sourceColumn": "traffic_volume",
            "summarizeBy": "none"
          },
          {
            "name": "Hour",
            "dataType": "int64",
            "sourceColumn": "Hour",
            "summarizeBy": "none"
          },
          {
            "name": "Date",
            "dataType": "dateTime",
            "sourceColumn": "Date",
            "summarizeBy": "none"
          },
          {
            "name": "Year",
            "dataType": "int64",
            "sourceColumn": "Year",
            "summarizeBy": "none"
          },
          {
            "name": "Temperature Celsius",
            "dataType": "double",
            "sourceColumn": "Temperature Celsius",
            "summarizeBy": "none"
          },
          {
            "name": "Traffic Category",
            "dataType": "string",
            "sourceColumn": "Traffic Category",
            "summarizeBy": "none"
          }
        ],
        "measures": [
          {
            "name": "Total Hours Analysed",
            "expression": "COUNTROWS(TrafficHourly)",
            "formatString": "#,0.00"
          },
          {
            "name": "Average Traffic Volume",
            "expression": "AVERAGE(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Average Temperature Celsius",
            "expression": "AVERAGE(TrafficHourly[Temperature Celsius])",
            "formatString": "#,0.00"
          },
          {
            "name": "Total Observed Volume",
            "expression": "SUM(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Median Traffic",
            "expression": "MEDIAN(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Traffic Standard Deviation",
            "expression": "STDEV.S(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Traffic Variance",
            "expression": "VAR.S(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Traffic Range",
            "expression": "MAX(TrafficHourly[traffic_volume])-MIN(TrafficHourly[traffic_volume])",
            "formatString": "#,0.00"
          },
          {
            "name": "Congested Hours",
            "expression": "COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500))",
            "formatString": "#,0.00"
          },
          {
            "name": "Congestion Probability",
            "expression": "DIVIDE([Congested Hours],[Total Hours Analysed])",
            "formatString": "0.00%"
          },
          {
            "name": "Clear Probability",
            "expression": "DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[weather_main]=\"Clear\")),[Total Hours Analysed])",
            "formatString": "0.00%"
          },
          {
            "name": "Congestion And Clear Probability",
            "expression": "DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[weather_main]=\"Clear\")),[Total Hours Analysed])",
            "formatString": "0.00%"
          },
          {
            "name": "Clear Given Congestion",
            "expression": "DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[weather_main]=\"Clear\")),[Congested Hours])",
            "formatString": "0.00%"
          },
          {
            "name": "High Temperature Given Congestion",
            "expression": "DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[temp]>292)),[Congested Hours])",
            "formatString": "0.00%"
          }
        ],
        "partitions": [
          {
            "name": "TrafficHourlyImport",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "// Blank query named TrafficHourly. References the original TrafficRaw query.",
                "let",
                " Required={\"holiday\",\"temp\",\"rain_1h\",\"snow_1h\",\"clouds_all\",\"weather_main\",\"weather_description\",\"date_time\",\"traffic_volume\"},",
                " Schema=if List.ContainsAll(Table.ColumnNames(TrafficRaw),Required) then TrafficRaw else error \"Missing required traffic columns\",",
                " Standard=Table.TransformColumns(Schema,{{\"holiday\",each if _=null or Text.Trim(_)=\"\" then \"None\" else Text.Trim(_),type text},{\"weather_main\",each Text.Proper(Text.Trim(_)),type text},{\"weather_description\",each Text.Lower(Text.Trim(_)),type text}}),",
                " DistinctRecords=Table.Distinct(Standard),",
                " Reference=Table.SelectRows(DistinctRecords,each [date_time]<#datetime(2017,1,1,0,0,0)),",
                " FixedTemp=Table.AddColumn(DistinctRecords,\"TempFixed\",(r)=> if r[temp]>=200 and r[temp]<=330 then r[temp] else let month=Date.Month(Date.From(r[date_time])),valid=Table.SelectRows(Reference,each Date.Month(Date.From([date_time]))=month and [temp]>=200 and [temp]<=330) in List.Median(valid[temp]),type number),",
                " FixedRain=Table.AddColumn(FixedTemp,\"RainFixed\",(r)=> if r[rain_1h]>=0 and r[rain_1h]<=9000 then r[rain_1h] else let month=Date.Month(Date.From(r[date_time])),valid=Table.SelectRows(Reference,each Date.Month(Date.From([date_time]))=month and [rain_1h]>=0 and [rain_1h]<=9000) in List.Median(valid[rain_1h]),type number),",
                " Repaired=Table.RenameColumns(Table.RemoveColumns(FixedRain,{\"temp\",\"rain_1h\"}),{{\"TempFixed\",\"temp\"},{\"RainFixed\",\"rain_1h\"}}),",
                " Severity=[Thunderstorm=5,Squall=5,Snow=4,Fog=4,Mist=3,Haze=3,Smoke=3,Rain=2,Drizzle=1,Clouds=0,Clear=0],",
                " Prioritised=Table.AddColumn(Repaired,\"Priority\",each Record.FieldOrDefault(Severity,[weather_main],0),Int64.Type),",
                " Grouped=Table.Group(Prioritised,{\"date_time\"},{{\"Primary\",each Table.First(Table.Sort(_,{{\"Priority\",Order.Descending},{\"weather_main\",Order.Ascending}})),type record},{\"traffic_volume\",each List.Median([traffic_volume]),type number}}),",
                " Expanded=Table.ExpandRecordColumn(Grouped,\"Primary\",{\"temp\",\"rain_1h\",\"snow_1h\",\"clouds_all\",\"weather_main\",\"weather_description\"}),",
                " HolidayMarked=Table.AddColumn(Table.SelectRows(Repaired,each [holiday]<>\"None\"),\"DateKey\",each Date.From([date_time]),type date),",
                " HolidayDates=Table.Group(HolidayMarked,{\"DateKey\"},{{\"holiday\",each List.First([holiday]),type text}}),",
                " WithDate=Table.AddColumn(Expanded,\"Date\",each Date.From([date_time]),type date),",
                " Joined=Table.NestedJoin(WithDate,{\"Date\"},HolidayDates,{\"DateKey\"},\"HolidayLookup\",JoinKind.LeftOuter),",
                " HolidayExpanded=Table.ExpandTableColumn(Joined,\"HolidayLookup\",{\"holiday\"},{\"holiday\"}),",
                " HolidayFilled=Table.ReplaceValue(HolidayExpanded,null,\"None\",Replacer.ReplaceValue,{\"holiday\"}),",
                " Hour=Table.AddColumn(HolidayFilled,\"Hour\",each Time.Hour(DateTime.Time([date_time])),Int64.Type),",
                " Year=Table.AddColumn(Hour,\"Year\",each Date.Year([Date]),Int64.Type),",
                " Celsius=Table.AddColumn(Year,\"Temperature Celsius\",each [temp]-273.15,type number),",
                " Category=Table.AddColumn(Celsius,\"Traffic Category\",each if [traffic_volume]<4500 then \"Low\" else if [traffic_volume]<=5500 then \"Medium\" else \"High\",type text),",
                " Typed=Table.TransformColumnTypes(Category,{{\"traffic_volume\",Int64.Type},{\"clouds_all\",Int64.Type}}),",
                " Sorted=Table.Sort(Typed,{{\"date_time\",Order.Ascending}}),",
                " Checked=if Table.RowCount(Sorted)=List.Count(List.Distinct(Sorted[date_time])) then Sorted else error \"Hourly timestamp uniqueness failed\"",
                "in Checked"
              ]
            }
          }
        ]
      },
      {
        "name": "DataQuality",
        "columns": [
          {
            "name": "Check",
            "dataType": "string",
            "sourceColumn": "Check",
            "summarizeBy": "none"
          },
          {
            "name": "Value",
            "dataType": "string",
            "sourceColumn": "Value",
            "summarizeBy": "none"
          }
        ],
        "measures": [],
        "partitions": [
          {
            "name": "DataQualityImport",
            "mode": "import",
            "source": {
              "type": "m",
              "expression": [
                "let R=TrafficRaw in #table(type table [Check=text,Value=text],{{\"Original rows\",Text.From(Table.RowCount(R))},{\"Original columns\",Text.From(Table.ColumnCount(R))},{\"Exact duplicate rows\",Text.From(Table.RowCount(R)-Table.RowCount(Table.Distinct(R)))},{\"Zero Kelvin records\",Text.From(Table.RowCount(Table.SelectRows(R,each [temp]=0)))},{\"Rain above 9000 mm\",Text.From(Table.RowCount(Table.SelectRows(R,each [rain_1h]>9000)))},{\"Unique observed hours\",Text.From(List.Count(List.Distinct(R[date_time])))}})"
              ]
            }
          }
        ]
      }
    ],
    "annotations": [
      {
        "name": "SourceGrain",
        "value": "40,575 unique observed hours; source pipeline training-only weather repairs"
      }
    ]
  }
}