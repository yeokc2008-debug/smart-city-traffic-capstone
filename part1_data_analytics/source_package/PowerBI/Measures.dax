// Add each measure separately to TrafficHourly if building manually.
Total Hours Analysed = COUNTROWS(TrafficHourly)
Average Traffic Volume = AVERAGE(TrafficHourly[traffic_volume])
Average Temperature Celsius = AVERAGE(TrafficHourly[Temperature Celsius])
Total Observed Volume = SUM(TrafficHourly[traffic_volume])
Median Traffic = MEDIAN(TrafficHourly[traffic_volume])
Traffic Standard Deviation = STDEV.S(TrafficHourly[traffic_volume])
Traffic Variance = VAR.S(TrafficHourly[traffic_volume])
Traffic Range = MAX(TrafficHourly[traffic_volume])-MIN(TrafficHourly[traffic_volume])
Congested Hours = COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500))
Congestion Probability = DIVIDE([Congested Hours],[Total Hours Analysed])
Clear Probability = DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[weather_main]="Clear")),[Total Hours Analysed])
Congestion And Clear Probability = DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[weather_main]="Clear")),[Total Hours Analysed])
Clear Given Congestion = DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[weather_main]="Clear")),[Congested Hours])
High Temperature Given Congestion = DIVIDE(COUNTROWS(FILTER(TrafficHourly,TrafficHourly[traffic_volume]>5500 && TrafficHourly[temp]>292)),[Congested Hours])
