<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="traffic.sqlite" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1300"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="traffic_raw" custom_title="0" dock_id="1" table="4,11:maintraffic_raw"/><dock_state state="000000ff00000000fd00000001000000020000043c00000316fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000043c0000013300ffffff0000026b0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="traffic_hourly" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="54"/><column index="3" value="51"/><column index="4" value="59"/><column index="5" value="64"/><column index="6" value="101"/><column index="7" value="257"/><column index="8" value="156"/><column index="9" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table><table schema="main" name="traffic_raw" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="101"/><column index="2" value="54"/><column index="3" value="51"/><column index="4" value="59"/><column index="5" value="64"/><column index="6" value="101"/><column index="7" value="257"/><column index="8" value="156"/><column index="9" value="89"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL Task 1*">-- Raw-record sums are record-weighted and can double count hours.
SELECT strftime('%Y',date_time) year, COUNT(*) records, COUNT(DISTINCT date_time) observed_hours,
 SUM(traffic_volume) total_record_volume, AVG(traffic_volume) average_traffic
FROM traffic_raw WHERE strftime('%Y',date_time) BETWEEN '2012' AND '2017' GROUP BY 1;
-- Preferred annual totals from unique observed hours, missing hours are not zero.
WITH annual AS (SELECT strftime('%Y',date_time) year,COUNT(*) observed_hours,
 SUM(traffic_volume) total_observed_traffic,AVG(traffic_volume) average_traffic
 FROM traffic_hourly WHERE strftime('%Y',date_time) BETWEEN '2012' AND '2017' GROUP BY 1)
SELECT *,total_observed_traffic-LAG(total_observed_traffic) OVER(ORDER BY year) change,
 100.0*(total_observed_traffic-LAG(total_observed_traffic) OVER(ORDER BY year))/LAG(total_observed_traffic) OVER(ORDER BY year) change_pct FROM annual;
-- Original holiday-labelled records (typically midnight only).
SELECT strftime('%Y',date_time) year,holiday,AVG(temp) kelvin,AVG(temp)-273.15 celsius,COUNT(*) n
 FROM traffic_raw WHERE holiday IN ('New Years Day','Labor Day') AND strftime('%Y',date_time) BETWEEN '2015' AND '2017' GROUP BY 1,2;
-- Full observed holiday date after date-level holiday propagation.
SELECT strftime('%Y',date_time) year,holiday,AVG(temp) kelvin,AVG(temp)-273.15 celsius,COUNT(*) n
 FROM traffic_hourly WHERE holiday IN ('New Years Day','Labor Day') AND strftime('%Y',date_time) BETWEEN '2015' AND '2017' GROUP BY 1,2;
SELECT COUNT(*) rows,COUNT(DISTINCT date_time) hours,MIN(date_time),MAX(date_time) FROM traffic_raw;</sql><sql name="SQL Task 2*">-- Transparent substitute for unavailable New Year 2015
SELECT strftime('%Y',date_time) year,holiday,AVG(temp) kelvin,AVG(temp)-273.15 celsius,COUNT(*) n FROM traffic_hourly WHERE holiday='New Years Day' AND strftime('%Y',date_time) IN ('2014','2016','2017','2018') GROUP BY 1,2;</sql><sql name="SQL 2.1*">-- Task 2.1 sample statistics. Variance and SD use denominator n-1.
WITH ordered AS (SELECT traffic_volume,ROW_NUMBER() OVER(ORDER BY traffic_volume) rn,COUNT(*) OVER() n FROM traffic_hourly),
m AS (SELECT AVG(traffic_volume) mu,COUNT(*) n FROM traffic_hourly)
SELECT m.n observed_hours,m.mu mean_traffic,
 (SELECT AVG(traffic_volume) FROM ordered WHERE rn IN ((n+1)/2,(n+2)/2)) median_traffic,
 SUM((traffic_volume-m.mu)*(traffic_volume-m.mu))/(m.n-1) sample_variance,
 SQRT(SUM((traffic_volume-m.mu)*(traffic_volume-m.mu))/(m.n-1)) sample_standard_deviation,
 MAX(traffic_volume)-MIN(traffic_volume) traffic_range FROM traffic_hourly CROSS JOIN m;</sql><sql name="SQL 2.2*">-- Task 2.2 Pearson correlation.
WITH m AS (SELECT AVG(temp) mt,AVG(traffic_volume) mv FROM traffic_hourly)
SELECT SUM((temp-mt)*(traffic_volume-mv))/SQRT(SUM((temp-mt)*(temp-mt))*SUM((traffic_volume-mv)*(traffic_volume-mv))) pearson_r FROM traffic_hourly CROSS JOIN m;</sql><sql name="SQL 3.1 and 3,2*">-- Tasks 3.1 and 3.2 probability, independence comparison and odds ratio.
WITH c AS (SELECT COUNT(*) n,SUM(traffic_volume&gt;5500) congested,SUM(weather_main='Clear') clear,
 SUM(traffic_volume&gt;5500 AND weather_main='Clear') clear_congested,
 SUM(traffic_volume&gt;5500 AND temp&gt;292) hot_congested,
 SUM(traffic_volume&lt;=5500 AND weather_main='Clear') clear_not,
 SUM(traffic_volume&gt;5500 AND weather_main='Clouds') clouds_congested,
 SUM(traffic_volume&lt;=5500 AND weather_main='Clouds') clouds_not FROM traffic_hourly)
SELECT congested*1.0/n p_congestion,clear*1.0/n p_clear,clear_congested*1.0/n p_joint,
 clear_congested*1.0/congested p_clear_given_congestion,hot_congested*1.0/congested p_hot_given_congestion,
 (congested*1.0/n)*(clear*1.0/n) independence_product,
 clear_congested*1.0*clouds_not/(clear_not*clouds_congested) odds_ratio FROM c;</sql><sql name="SQL 4C*">-- Task 4C hourly weather means and category sample counts.
SELECT weather_main,COUNT(*) observed_hours,AVG(traffic_volume) average_traffic FROM traffic_hourly GROUP BY weather_main ORDER BY average_traffic DESC;
-- Task 4A daily observed-hour averages for 2015, 2016 and 2017.</sql><sql name="SQL 4A*">-- Task 4A daily observed-hour averages for 2015, 2016 and 2017.
SELECT DATE(date_time) date,strftime('%Y',date_time) year,COUNT(*) observed_hours,AVG(traffic_volume) average_traffic FROM traffic_hourly WHERE strftime('%Y',date_time)</sql><sql name="SQL 4B*">-- Task 4B hourly traffic averages for 2017.
SELECT CAST(strftime('%H',date_time) AS INTEGER) hour,COUNT(*) observed_hours,AVG(traffic_volume) average_traffic FROM traffic_hourly WHERE strftime('%Y',date_time)='2017' GROUP BY 1 ORDER BY 1;
</sql><current_tab id="7"/></tab_sql></sqlb_project>
